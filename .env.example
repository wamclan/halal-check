# Copy these into Vercel: Project > Settings > Environment Variables (or into your shell for `npm run dev`).
GEMINI_API_KEY=            # required for the Photo tab. Create it in Google AI Studio.
GEMINI_MODEL=gemini-2.5-flash   # optional. Change it if Google renames or retires the model.
CONTACT_EMAIL=             # optional. Sent in the User-Agent to Open Food Facts, as they ask API users to do.
RATE_PER_HOUR=12           # optional. Photos per visitor per hour.
DAILY_CAP=400              # optional. Photos per day for the whole site (cost ceiling).
PRODUCT_RATE_PER_HOUR=90   # optional. Barcode lookups per visitor per hour.
# Optional shared counters (recommended). Add Upstash Redis from the Vercel Marketplace and it fills these in:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
